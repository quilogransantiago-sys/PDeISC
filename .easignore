# Archivos/directorios que NO se suben a EAS Build (raíz del repo Git).
# EAS CLI lee este .easignore desde la raíz del repositorio.

# Dependencias y cachés
node_modules/
.expo/
dist/
web-build/
.git/
.DS_Store
*.log
npm-debug.*

# Backups comprimidos (ej. Little_chochi.zip)
*.zip

# Salida temporal de `eas build:inspect`
eas-archive/

# Otros proyectos del repo (no son parte de Little Chochi)
/js/
/react/
/reactNative/
/nodejs/
/web_diario/
