# Copiá este archivo a `.env` y completá con tus valores reales.
# No subas nunca `.env` con secretos reales al repositorio.

# Servidor
PORT=4000
NODE_ENV=development

# Base de datos MySQL (XAMPP / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=little_chochi

# Seguridad / JWT
# JWT_SECRET debe ser una cadena larga y aleatoria (mínimo 32 caracteres).
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS: orígenes permitidos separados por coma (el frontend web de Expo)
CORS_ORIGIN=http://localhost:8081,http://localhost:19006

# Contacto de la tienda (para el botón de WhatsApp)
WHATSAPP_NUMBER=5491100000000

# OAuth social (completá con credenciales reales de cada proveedor)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
