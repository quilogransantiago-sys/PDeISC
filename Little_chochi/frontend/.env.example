# Variables de entorno del frontend (ejemplo, sin secretos).
# Copiá a `.env`.
# La URL de la API se detecta sola (localhost en web, IP local en el celular vía Expo Go).
# Solo descomentá y cambiá EXPO_PUBLIC_API_URL si necesitás forzarla.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000/api
EXPO_PUBLIC_WHATSAPP_NUMBER=5491100000000
# Client ID de Google (Google Cloud Console → Credenciales → ID de cliente OAuth)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# App ID de Facebook (Meta for Developers → app → Configuración → Básica)
EXPO_PUBLIC_FACEBOOK_APP_ID=
# Client ID de GitHub (GitHub → Settings → Developer settings → OAuth Apps)
EXPO_PUBLIC_GITHUB_CLIENT_ID=
